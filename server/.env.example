HTTP_PORT=9091

# Use "serial" for a direct ESP32 connection or "socket" for a remote source.
ROBOT_TRANSPORT=serial

# Required only when ROBOT_TRANSPORT=serial.
# Ubuntu examples: /dev/murin-cdc and /dev/murin-console
# Windows examples: COM11 and COM10
USB_PORT=
USB_BAUDRATE=2000000
CONSOLE_PORT=
CONSOLE_BAUDRATE=115200
